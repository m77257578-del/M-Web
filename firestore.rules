rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // مجموعة المشاريع: القراءة للجميع، والكتابة ممنوعة تماماً من الموقع
    match /projects/{project} {
      allow read: if true;
      allow write: if false;
    }
    
    // مجموعة الطلبات: إنشاء مستند جديد متاح للجميع، والقراءة والتعديل ممنوعان تماماً لحماية خصوصية العملاء
    match /orders/{order} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
